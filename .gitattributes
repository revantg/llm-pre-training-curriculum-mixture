# Session transcripts are stored as Git LFS pointers.
# The conversation text is never written into git objects — only a pointer
# (oid + size) is versioned, so `git log -p`, `git grep` and diffs stay clean.
transcripts/*.jsonl  filter=lfs diff=lfs merge=lfs -text
transcripts/*.html   filter=lfs diff=lfs merge=lfs -text
transcripts/*.gz     filter=lfs diff=lfs merge=lfs -text

# Large course-export payloads (raw video captions + fetched paper PDFs/figures)
session_5_era_v5/transcripts/*.vtt        filter=lfs diff=lfs merge=lfs -text
session_5_era_v5/transcripts/*.info.json  filter=lfs diff=lfs merge=lfs -text
session_5_era_v5/papers/**/*.pdf          filter=lfs diff=lfs merge=lfs -text
session_5_era_v5/papers/**/*.png          filter=lfs diff=lfs merge=lfs -text
session_5_era_v5/papers/**/*.tar.gz       filter=lfs diff=lfs merge=lfs -text

# Keep markdown/JSON/HTML specs as normal diffable text.
*.md    text
*.json  text
